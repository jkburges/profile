[user]
	email = jon@biteable.com
	signingkey = 38D5F89366BE9C21
[core]
	editor = vim
	excludesFile = ~/.gitignore
[alias]
	co = checkout
	br = branch
	saveskip = !git add -A && git commit -m 'SAVE POINT' -m '[skip ci]'
  save = !git add -A && git commit -m 'SAVE POINT'
[commit]
	gpgsign = true
[pull]
	rebase = false
[init]
	defaultBranch = main
[diff]
	renameLimit = 1500
